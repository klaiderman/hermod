# Copy this to .env. Everything here is validated at boot (src/config/env.validation.ts):
# the app refuses to start if a required var is missing or malformed. CHATGPT_BASE_URL is the only
# required value; the rest have safe defaults. HEADLESS is false by default because signed-out
# ChatGPT challenges headless, so a real headful browser is more reliable. HEADFUL_OFFSCREEN defaults
# to true so a local run keeps Chromium off the desktop (headful opens one window per BrowserContext);
# the Docker image pins it to false, since under Xvfb there is no desktop to hide from and that is the
# configuration verified against the live target.
# The timeouts, pool, and backoff values tune concurrency and the four request timers.
# CONVERSATION_TTL_MS is how long an idle multi-turn conversation stays live before it is swept
# (its live-conversation cap mirrors POOL_MAX). PROXY_URL is the (currently inert) seam where
# geo_location routing would plug in.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

CHATGPT_BASE_URL=https://chatgpt.com

BROWSER_EXECUTABLE_PATH=
HEADLESS=false
HEADFUL_OFFSCREEN=true

POOL_MAX=3
POOL_MIN=0
POOL_ACQUIRE_TIMEOUT_MS=10000
CONTEXT_MAX_USES=15

NAV_TIMEOUT_MS=30000
FIRST_BYTE_MS=15000
IDLE_MS=20000
WALL_CLOCK_MS=120000

RETRY_MAX_ATTEMPTS=3
BACKOFF_INITIAL_MS=500
BACKOFF_MAX_MS=8000

CONVERSATION_TTL_MS=300000

PROXY_URL=
