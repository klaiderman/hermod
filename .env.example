# Hermod configuration. Copy to `.env` and adjust. These are validated at boot
# (src/config/env.validation.ts); the app won't start if a required var is missing
# or malformed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info                     # trace | debug | info | warn | error | fatal

# Required. No sensible default, so we don't guess one.
CHATGPT_BASE_URL=https://chatgpt.com

# Path to the Chromium binary. Leave blank to use the one Patchright/Playwright
# installs (the Docker image does this for you).
BROWSER_EXECUTABLE_PATH=
HEADLESS=false                     # headful by default: signed-out ChatGPT challenges headless. See the README for running it invisibly.
HEADFUL_OFFSCREEN=false            # true renders the headful window off-screen (invisible) on a desktop OS. Ignored when HEADLESS=true.

# Concurrency
POOL_MAX=3                         # max concurrent browser contexts
POOL_MIN=0
POOL_ACQUIRE_TIMEOUT_MS=10000      # wait for a free context before giving up with a 503
CONTEXT_MAX_USES=15                # recycle a context after this many requests

# Timeouts (the four timers; see the README)
NAV_TIMEOUT_MS=30000               # navigation / response headers
FIRST_BYTE_MS=15000                # from response obtained to the first answer chunk
IDLE_MS=20000                      # max gap between chunks once the answer has started
WALL_CLOCK_MS=120000               # whole-request budget across all retries

# Retry / backoff
RETRY_MAX_ATTEMPTS=3
BACKOFF_INITIAL_MS=500
BACKOFF_MAX_MS=8000

# Proxy seam. geo_location is validated on the request but currently ignored;
# this is where a proxy provider URL would plug in.
PROXY_URL=
